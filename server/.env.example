# ============================================================
# SafeED-UP Server Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/safeedup?retryWrites=true&w=majority

# JWT Secrets (Minimum 32 random characters for production)
JWT_SECRET=safeedup_super_secret_jwt_access_key_min_32_chars_2026
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_SECRET=safeedup_super_secret_jwt_refresh_key_min_32_chars_2026
JWT_REFRESH_EXPIRES=7d

# Cookies & Security
COOKIE_SECRET=safeedup_cookie_secret_key_32_chars_long
SAME_SITE=strict

# Frontend URL (for CORS + email links)
CLIENT_URL=http://localhost:5173

# Nodemailer (Gmail example - use App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM="SafeED-UP Notification <noreply@safeedup.gov.in>"

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=uploads

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
PUBLIC_RATE_LIMIT_MAX=50

