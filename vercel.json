{
  "version": 2,
  "buildCommand": "npm install && npm install --prefix client && npm run build --prefix client && cp -r client/dist/* .",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api/sync",
      "destination": "/api/sync.cjs"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
